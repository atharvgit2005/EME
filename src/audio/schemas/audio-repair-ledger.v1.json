{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://editing-mechanics-engine.org/schemas/audio-repair-ledger.v1.json",
  "title": "AudioRepairDecisionLedgerEvent",
  "description": "Draft 2020-12 schema for authoritative decision ledger events and audit records in EME x Earshot",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "timestamp",
    "proposal_id",
    "correlation_key",
    "project_revision"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CONFIDENCE_EVALUATED",
        "CONFIDENCE_CALIBRATED",
        "ROUTING_DETERMINED",
        "HUMAN_REVIEW_REQUESTED",
        "HUMAN_APPROVAL_RECORDED",
        "HUMAN_REJECTION_RECORDED",
        "APPROVAL_INVALIDATED",
        "EXECUTION_INTENDED",
        "EXECUTION_COMMITTED",
        "EXECUTION_FAILED",
        "OUTCOME_EVALUATED",
        "REPAIR_VERIFIED",
        "DELIVERY_PROMOTED",
        "DELIVERY_WITHHELD",
        "RECONCILIATION_REQUIRED"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "finding_id": {
      "type": "string",
      "maxLength": 128
    },
    "request_id": {
      "type": "string",
      "maxLength": 128
    },
    "correlation_key": {
      "type": "string",
      "minLength": 4,
      "maxLength": 256
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "policy_version": {
      "type": "string",
      "maxLength": 64
    },
    "source_media_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "render_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "target": {
      "type": "object",
      "required": ["clip_id"],
      "properties": {
        "clip_id": { "type": "string" },
        "track_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    },
    "supersedes_event_id": {
      "type": "string",
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
