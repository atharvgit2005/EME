{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eme.local/schemas/earshot-qa-response.v1.json",
  "title": "EarshotQaResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "status",
    "mode",
    "execution_time_ms"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^req-earshot-[a-zA-Z0-9_-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "NOT_MEASURED",
        "NOT_APPLICABLE",
        "TIMEOUT",
        "WORKER_ERROR"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "fast_dsp",
        "full_perception"
      ]
    },
    "execution_time_ms": {
      "type": "number",
      "minimum": 0
    },
    "loudness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "integrated_lufs": {
          "type": ["number", "null"]
        },
        "lufs_reason": {
          "type": ["string", "null"]
        },
        "true_peak_dbtp": {
          "type": ["number", "null"]
        },
        "true_peak_reason": {
          "type": ["string", "null"]
        },
        "loudness_range_lu": {
          "type": ["number", "null"]
        },
        "clipping_samples": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "compliant": {
          "type": ["boolean", "null"]
        }
      }
    },
    "sfx_integrity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "rising_glides": {
          "type": "integer",
          "minimum": 0
        },
        "double_hits": {
          "type": "integer",
          "minimum": 0
        },
        "clicks": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "time_seconds", "detail"],
            "properties": {
              "type": { "type": "string" },
              "time_seconds": { "type": "number", "minimum": 0 },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "sync": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "analyzed_cuts": {
          "type": "integer",
          "minimum": 0
        },
        "mean_offset_ms": {
          "type": ["number", "null"]
        },
        "max_offset_ms": {
          "type": ["number", "null"]
        },
        "max_offset_ticks": {
          "type": ["integer", "null"]
        },
        "aligned": {
          "type": ["boolean", "null"]
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cut_frame",
              "cut_seconds",
              "sound_onset_seconds",
              "offset_ms",
              "offset_ticks"
            ],
            "properties": {
              "cut_frame": {
                "type": "integer",
                "minimum": 0
              },
              "cut_seconds": {
                "type": "number",
                "minimum": 0
              },
              "sound_onset_seconds": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "offset_ms": {
                "type": ["number", "null"]
              },
              "offset_ticks": {
                "type": ["integer", "null"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.0
              }
            }
          }
        }
      }
    },
    "critique": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pass_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "review", "reject"]
        },
        "subscores": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "sheet_path": {
      "type": ["string", "null"]
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
