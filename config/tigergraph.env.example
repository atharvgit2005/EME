# Copy to .env.local and use: node --env-file=.env.local bin/eme-studio.js
# Set the exact REST++ base URL. Include /restpp when your deployment requires it.
# Local legacy REST++ example: http://127.0.0.1:9000
# Remote example: https://your-instance.example/restpp
EME_TIGERGRAPH_URL=
EME_TIGERGRAPH_GRAPH=EME
EME_TIGERGRAPH_TOKEN=
# Savanna supports a database secret instead of a bearer token. Set only one.
EME_TIGERGRAPH_SECRET=
EME_TIGERGRAPH_TIMEOUT_MS=8000
# Optional unique workspace namespace. Default is a stable hash of the workspace path.
# Each namespace must have one workspace writer; do not share it across unrelated workspaces.
EME_TIGERGRAPH_NAMESPACE=
