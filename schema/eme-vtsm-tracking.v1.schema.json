{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eme.local/schema/eme-vtsm-tracking.v1.schema.json",
  "title": "EME VTSM Sidecar Tracking Contract",
  "description": "Versioned sidecar artifact specification for Visual-Temporal State Machine tracking results in EME. Preserves project-schema isolation by persisting outside eme-project.v1.schema.json.",
  "type": "object",
  "required": [
    "contractVersion",
    "sessionId",
    "projectId",
    "sourceMedia",
    "timebase",
    "coordinateConvention",
    "lifecycle",
    "tracks",
    "frames",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "sessionId": {
      "type": "string",
      "description": "Unique UUID for the tracking session"
    },
    "projectId": {
      "type": "string",
      "description": "Binding to the authorized parent EME project ID"
    },
    "sourceMedia": {
      "type": "object",
      "required": ["mediaId", "sourceSha256", "filePath", "dimensions", "durationSec", "totalFrames"],
      "additionalProperties": false,
      "properties": {
        "mediaId": { "type": "string" },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "filePath": { "type": "string" },
        "dimensions": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "durationSec": { "type": "number", "minimum": 0 },
        "totalFrames": { "type": "integer", "minimum": 1 }
      }
    },
    "timebase": {
      "type": "object",
      "required": ["ticksPerSecond", "rationalFps", "durationTicks"],
      "additionalProperties": false,
      "properties": {
        "ticksPerSecond": {
          "type": "integer",
          "enum": [120000]
        },
        "rationalFps": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "additionalProperties": false,
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "type": "integer", "minimum": 1 }
          }
        },
        "durationTicks": { "type": "integer", "minimum": 0 }
      }
    },
    "coordinateConvention": {
      "type": "object",
      "required": ["space", "origin"],
      "additionalProperties": false,
      "properties": {
        "space": {
          "type": "string",
          "enum": ["normalized_0_1", "source_pixels"]
        },
        "origin": {
          "type": "string",
          "enum": ["top_left"]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["status", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["initialized", "tracking", "occluded", "lost", "completed", "failed", "canceled"]
        },
        "errorMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trackId", "label"],
        "additionalProperties": false,
        "properties": {
          "trackId": { "type": ["integer", "string"] },
          "label": { "type": "string" },
          "color": { "type": "string" },
          "firstFrame": { "type": "integer", "minimum": 0 },
          "lastFrame": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frameIdx", "ptsTicks", "ptsSec", "states"],
        "additionalProperties": false,
        "properties": {
          "frameIdx": { "type": "integer", "minimum": 0 },
          "ptsTicks": { "type": "integer", "minimum": 0 },
          "ptsSec": { "type": "number", "minimum": 0 },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["trackId", "visibility", "confidence"],
              "additionalProperties": false,
              "properties": {
                "trackId": { "type": ["integer", "string"] },
                "visibility": {
                  "type": "string",
                  "enum": ["visible", "occluded", "lost"]
                },
                "bbox": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 4,
                  "maxItems": 4,
                  "description": "[x, y, width, height]"
                },
                "mask": {
                  "type": "object",
                  "required": ["format"],
                  "properties": {
                    "format": { "type": "string", "enum": ["rle", "polygon", "bbox_only"] },
                    "counts": { "type": ["string", "array"] },
                    "size": { "type": "array", "items": { "type": "integer" } },
                    "polygon": { "type": "array" }
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "isKeyframe": { "type": "boolean" },
                "triggerReason": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["worker", "model", "modelSha256", "device", "generatedAt"],
      "additionalProperties": false,
      "properties": {
        "worker": { "type": "string" },
        "model": { "type": "string" },
        "modelSha256": { "type": "string" },
        "device": { "type": "string" },
        "throughputFps": { "type": "number" },
        "totalDurationMs": { "type": "number" },
        "generatedAt": { "type": "string" }
      }
    }
  }
}
