{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EMEPreferenceFeedback",
  "description": "Canonical schema for auditable, revision-safe preference feedback records linking candidate selection and rejection to exact manifests (PF-08).",
  "type": "object",
  "required": [
    "schema_version",
    "feedback_id",
    "timestamp",
    "preference_id",
    "candidate_set_id",
    "selected_candidate_id",
    "selected_manifest_id",
    "rejected_candidate_ids",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "feedback_id": {
      "type": "string",
      "pattern": "^fb-[a-f0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "preference_id": {
      "type": "string",
      "pattern": "^pref-[a-f0-9]+$"
    },
    "candidate_set_id": {
      "type": "string",
      "pattern": "^cset-[a-f0-9]+$"
    },
    "selected_candidate_id": {
      "type": "string"
    },
    "selected_manifest_id": {
      "type": "string"
    },
    "unselected_candidate_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "explicitly_rejected_candidate_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rejected_candidate_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evaluation_evidence": {
      "type": "object",
      "properties": {
        "selected_rank": { "type": "integer" },
        "selected_composite_score": { "type": "number" },
        "selected_qa_score": { "type": "number" },
        "selected_musical_score": { "type": "number" },
        "selected_preference_score": { "type": "number" }
      }
    },
    "provenance": {
      "type": "string"
    }
  }
}
