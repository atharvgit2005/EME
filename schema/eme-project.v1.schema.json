{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eme.local/schemas/eme-project.v1.schema.json",
  "title": "EditingMechanicsEngineProject",
  "description": "Canonical project specification for the Editing Mechanics Engine (EME) v1.0.0",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "revision",
    "canvas",
    "timebase",
    "assets",
    "tracks",
    "clips"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique stable identifier for the editing project"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing project mutation revision count"
    },
    "title": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspectRatio": { "type": "string" },
        "backgroundColor": { "type": "string", "default": "#000000" }
      }
    },
    "timebase": {
      "type": "object",
      "required": ["fps", "ticksPerSecond", "durationTicks", "endpointConvention"],
      "properties": {
        "fps": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "type": "integer", "minimum": 1 }
          }
        },
        "ticksPerSecond": {
          "type": "integer",
          "default": 120000,
          "description": "Integer tick resolution. 120,000 divides cleanly by 24, 25, 30, 48, 50, 60, and 120fps."
        },
        "durationTicks": {
          "type": "integer",
          "minimum": 0,
          "description": "Total project composition duration in integer ticks"
        },
        "endpointConvention": {
          "type": "string",
          "enum": ["half-open"],
          "description": "Standard interval representation [start, end) where end is non-inclusive"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clip"
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animationTrack"
      },
      "default": []
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "type", "src"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["video", "audio", "image", "font", "overlay"]
        },
        "src": {
          "type": "string",
          "description": "Project-relative path to the media file"
        },
        "sha256": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "kind", "zIndex"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["visual", "audio"] },
        "zIndex": {
          "type": "integer",
          "description": "Visual compositing stacking order. Higher index renders above lower index."
        },
        "muted": { "type": "boolean", "default": false },
        "locked": { "type": "boolean", "default": false }
      }
    },
    "clip": {
      "type": "object",
      "required": ["id", "trackId", "type", "startTick", "durationTicks"],
      "properties": {
        "id": { "type": "string" },
        "trackId": { "type": "string" },
        "type": { "type": "string", "enum": ["video", "text", "graphic", "audio"] },
        "startTick": { "type": "integer", "minimum": 0 },
        "durationTicks": { "type": "integer", "minimum": 1 },
        "source": {
          "type": "object",
          "properties": {
            "assetId": { "type": "string" },
            "trimInTick": { "type": "integer", "minimum": 0, "default": 0 },
            "trimOutTick": { "type": "integer", "minimum": 0 }
          }
        },
        "transform": {
          "type": "object",
          "properties": {
            "x": { "type": "number", "default": 0 },
            "y": { "type": "number", "default": 0 },
            "scaleX": { "type": "number", "default": 1.0 },
            "scaleY": { "type": "number", "default": 1.0 },
            "rotation": { "type": "number", "default": 0 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
            "anchorX": { "type": "number", "default": 0.5 },
            "anchorY": { "type": "number", "default": 0.5 }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "fontAssetId": { "type": "string" },
            "fontSize": { "type": "number", "minimum": 1 },
            "color": { "type": "string", "default": "#ffffff" },
            "textAlign": { "type": "string", "enum": ["left", "center", "right"], "default": "center" },
            "letterSpacing": { "type": "number", "default": 0 },
            "lineHeight": { "type": "number", "default": 1.2 }
          }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" },
          "default": []
        },
        "audio": {
          "type": "object",
          "properties": {
            "volume": { "type": "number", "minimum": 0, "maximum": 2, "default": 1.0 },
            "volumeEnvelope": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["offsetTick", "volume"],
                "properties": {
                  "offsetTick": { "type": "integer", "minimum": 0 },
                  "volume": { "type": "number", "minimum": 0, "maximum": 2 }
                }
              }
            }
          }
        }
      }
    },
    "effect": {
      "type": "object",
      "required": ["type", "parameters"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["blendMode", "invert", "contrast", "brightness", "blur", "transition"]
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "animationTrack": {
      "type": "object",
      "required": ["clipId", "property", "keyframes"],
      "properties": {
        "clipId": { "type": "string" },
        "property": { "type": "string" },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["offsetTick", "value", "easing"],
            "properties": {
              "offsetTick": { "type": "integer", "minimum": 0 },
              "value": {},
              "easing": {
                "type": "string",
                "enum": ["linear", "easeIn", "easeOut", "easeInOut", "power2.out", "power3.out", "spring"]
              }
            }
          }
        }
      }
    }
  }
}
