// eme-tigergraph.v1. Run once in an empty, dedicated graph namespace. No DROP commands.
CREATE VERTEX EMEWorkspace (PRIMARY_ID id STRING, namespace STRING, schema_version STRING, revision STRING, state STRING, project_id STRING, projection_revision STRING)
CREATE VERTEX EMEDesignSet (PRIMARY_ID id STRING, workspace_id STRING, set_id STRING, recipe STRING, snapshot STRING, base_revision INT, projection_revision STRING)
CREATE VERTEX EMECandidate (PRIMARY_ID id STRING, workspace_id STRING, candidate_id STRING, profile_id STRING, recipe STRING, aspect STRING, summary_json STRING, projection_revision STRING)
CREATE VERTEX EMEProfile (PRIMARY_ID id STRING, workspace_id STRING, profile_id STRING, projection_revision STRING)
CREATE VERTEX EMEParameter (PRIMARY_ID id STRING, workspace_id STRING, axis STRING, bucket STRING, projection_revision STRING)
CREATE VERTEX EMEFeedback (PRIMARY_ID id STRING, workspace_id STRING, feedback_id STRING, kind STRING, active BOOL, recorded_at STRING, evidence_json STRING, projection_revision STRING)
CREATE VERTEX EMEComponent (PRIMARY_ID id STRING, workspace_id STRING, component_id STRING, current_candidate_id STRING, present BOOL, projection_revision STRING)
CREATE DIRECTED EDGE EME_HAS_SET (FROM EMEWorkspace, TO EMEDesignSet) WITH REVERSE_EDGE="EME_HAS_SET_REVERSE"
CREATE DIRECTED EDGE EME_HAS_CANDIDATE (FROM EMEWorkspace, TO EMECandidate, recipe STRING, aspect STRING, profile_id STRING, base_revision INT, projection_revision STRING) WITH REVERSE_EDGE="EME_HAS_CANDIDATE_REVERSE"
CREATE DIRECTED EDGE EME_SET_CANDIDATE (FROM EMEDesignSet, TO EMECandidate) WITH REVERSE_EDGE="EME_SET_CANDIDATE_REVERSE"
CREATE DIRECTED EDGE EME_HAS_FEEDBACK (FROM EMEWorkspace, TO EMEFeedback) WITH REVERSE_EDGE="EME_HAS_FEEDBACK_REVERSE"
CREATE DIRECTED EDGE EME_PREFERRED (FROM EMEFeedback, TO EMECandidate) WITH REVERSE_EDGE="EME_PREFERRED_REVERSE"
CREATE DIRECTED EDGE EME_COMPARED (FROM EMEFeedback, TO EMECandidate) WITH REVERSE_EDGE="EME_COMPARED_REVERSE"
CREATE DIRECTED EDGE EME_MOTION_REVIEWED (FROM EMEFeedback, TO EMECandidate) WITH REVERSE_EDGE="EME_MOTION_REVIEWED_REVERSE"
CREATE DIRECTED EDGE EME_REPLACES (FROM EMEFeedback, TO EMEFeedback) WITH REVERSE_EDGE="EME_REPLACES_REVERSE"
CREATE DIRECTED EDGE EME_WITHDRAWS (FROM EMEFeedback, TO EMEFeedback) WITH REVERSE_EDGE="EME_WITHDRAWS_REVERSE"
CREATE DIRECTED EDGE EME_USES_PROFILE (FROM EMECandidate, TO EMEProfile) WITH REVERSE_EDGE="EME_USES_PROFILE_REVERSE"
CREATE DIRECTED EDGE EME_USES_PARAMETER (FROM EMECandidate, TO EMEParameter) WITH REVERSE_EDGE="EME_USES_PARAMETER_REVERSE"
CREATE DIRECTED EDGE EME_REVISES (FROM EMECandidate, TO EMECandidate) WITH REVERSE_EDGE="EME_REVISES_REVERSE"
CREATE DIRECTED EDGE EME_HAS_COMPONENT (FROM EMEWorkspace, TO EMEComponent) WITH REVERSE_EDGE="EME_HAS_COMPONENT_REVERSE"
CREATE DIRECTED EDGE EME_COMPONENT_CANDIDATE (FROM EMEComponent, TO EMECandidate, recipe STRING, aspect STRING, profile_id STRING, base_revision INT, projection_revision STRING) WITH REVERSE_EDGE="EME_COMPONENT_CANDIDATE_REVERSE"
CREATE GRAPH EME (EMEWorkspace, EMEDesignSet, EMECandidate, EMEProfile, EMEParameter, EMEFeedback, EMEComponent, EME_HAS_SET, EME_HAS_CANDIDATE, EME_SET_CANDIDATE, EME_HAS_FEEDBACK, EME_PREFERRED, EME_COMPARED, EME_MOTION_REVIEWED, EME_REPLACES, EME_WITHDRAWS, EME_USES_PROFILE, EME_USES_PARAMETER, EME_REVISES, EME_HAS_COMPONENT, EME_COMPONENT_CANDIDATE, EME_HAS_SET_REVERSE, EME_HAS_CANDIDATE_REVERSE, EME_SET_CANDIDATE_REVERSE, EME_HAS_FEEDBACK_REVERSE, EME_PREFERRED_REVERSE, EME_COMPARED_REVERSE, EME_MOTION_REVIEWED_REVERSE, EME_REPLACES_REVERSE, EME_WITHDRAWS_REVERSE, EME_USES_PROFILE_REVERSE, EME_USES_PARAMETER_REVERSE, EME_REVISES_REVERSE, EME_HAS_COMPONENT_REVERSE, EME_COMPONENT_CANDIDATE_REVERSE)
