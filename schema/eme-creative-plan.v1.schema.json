{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eme.local/schemas/eme-creative-plan.v1.schema.json",
  "title": "EditingMechanicsEngineCreativePlan",
  "description": "Structured, authoritative Creative Plan generated by EME Creative Director LLM runtime and validated before compilation to canonical EME operations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "source_request_id",
    "project_snapshot",
    "creative_intent",
    "deliverable",
    "narrative_beats",
    "visual_events",
    "audio_direction",
    "unsupported_features",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Canonical schema version"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^creative-plan-[a-zA-Z0-9_-]+$",
      "description": "Unique stable identifier for the Creative Plan"
    },
    "source_request_id": {
      "type": "string",
      "description": "Reference to the source user request or intent ID"
    },
    "project_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "base_revision",
        "snapshot_sha256",
        "timebase_ticks_per_second"
      ],
      "properties": {
        "project_id": { "type": "string" },
        "base_revision": { "type": "integer", "minimum": 0 },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "timebase_ticks_per_second": {
          "type": "integer",
          "const": 120000
        }
      }
    },
    "creative_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "target_audience", "style", "pacing", "desired_outcome"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "target_audience": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "pacing": {
          "type": "string",
          "enum": ["fast", "moderate", "deliberate", "dynamic"]
        },
        "desired_outcome": { "type": "string", "minLength": 1 },
        "narrative_arc": { "type": "string" }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "aspect_ratio", "frame_rate", "target_duration_ticks"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspect_ratio": {
          "type": "string",
          "enum": ["9:16", "16:9", "4:3", "1:1", "custom"]
        },
        "frame_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "type": "integer", "minimum": 1 }
          }
        },
        "target_duration_ticks": {
          "type": "integer",
          "minimum": 1,
          "description": "Total duration in exact 120,000 ticks/sec EME timebase"
        }
      }
    },
    "narrative_beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat_id",
          "sequence_index",
          "beat_type",
          "narrative_purpose",
          "source_media_ref",
          "source_range",
          "timeline_range",
          "editorial_decisions"
        ],
        "properties": {
          "beat_id": {
            "type": "string",
            "pattern": "^beat-[a-zA-Z0-9_-]+$"
          },
          "sequence_index": {
            "type": "integer",
            "minimum": 0
          },
          "beat_type": {
            "type": "string",
            "enum": ["hook", "setup", "body", "climax", "payoff", "call_to_action", "outro"]
          },
          "narrative_purpose": { "type": "string", "minLength": 1 },
          "source_media_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id"],
            "properties": {
              "asset_id": { "type": "string" },
              "media_path": { "type": "string" },
              "clip_id": { "type": "string" }
            }
          },
          "source_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_tick", "end_tick", "duration_ticks"],
            "properties": {
              "start_tick": { "type": "integer", "minimum": 0 },
              "end_tick": { "type": "integer", "minimum": 0 },
              "duration_ticks": { "type": "integer", "minimum": 1 }
            }
          },
          "timeline_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_tick", "end_tick", "duration_ticks"],
            "properties": {
              "start_tick": { "type": "integer", "minimum": 0 },
              "end_tick": { "type": "integer", "minimum": 0 },
              "duration_ticks": { "type": "integer", "minimum": 1 }
            }
          },
          "editorial_decisions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cut_type", "reframing"],
            "properties": {
              "cut_type": {
                "type": "string",
                "enum": ["hard_cut", "jump_cut", "crossfade", "none"]
              },
              "pacing_weight": { "type": "number", "minimum": 0.0 },
              "reframing": {
                "type": "object",
                "additionalProperties": false,
                "required": ["enabled", "mode", "target_aspect_ratio"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "mode": {
                    "type": "string",
                    "enum": ["subject_centered", "face_centered", "rule_of_thirds", "custom_crop", "none"]
                  },
                  "target_aspect_ratio": {
                    "type": "string",
                    "enum": ["9:16", "16:9", "4:3", "1:1", "custom"]
                  },
                  "anchor_composition": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "subject_x": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                      "subject_y": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                      "headroom_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                      "shoulder_balance_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                      "left_shoulder_visible": { "type": "boolean" },
                      "right_shoulder_visible": { "type": "boolean" },
                      "upper_body_anchor": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["x", "y"],
                        "properties": {
                          "x": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                          "y": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
                        }
                      }
                    }
                  },
                  "crop_rect": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y", "width", "height"],
                    "properties": {
                      "x": { "type": "integer", "minimum": 0 },
                      "y": { "type": "integer", "minimum": 0 },
                      "width": { "type": "integer", "minimum": 1 },
                      "height": { "type": "integer", "minimum": 1 }
                    }
                  },
                  "smoothing": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "temporal_window_ticks": { "type": "integer", "minimum": 0 },
                      "algorithm": {
                        "type": "string",
                        "enum": ["exponential_moving_average", "box", "none"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "visual_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timeline_range",
          "event_type",
          "content",
          "spatial_constraints",
          "motion"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^event-[a-zA-Z0-9_-]+$"
          },
          "timeline_range": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_tick", "end_tick", "duration_ticks"],
            "properties": {
              "start_tick": { "type": "integer", "minimum": 0 },
              "end_tick": { "type": "integer", "minimum": 0 },
              "duration_ticks": { "type": "integer", "minimum": 1 }
            }
          },
          "event_type": {
            "type": "string",
            "enum": ["title_card", "caption", "kinetic_text", "broll_cutaway", "motion_graphic", "lower_third"]
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "font_family": { "type": "string" },
              "font_size": { "type": "number", "minimum": 1 },
              "font_color": { "type": "string" },
              "asset_id": { "type": "string" }
            }
          },
          "spatial_constraints": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target_anchor", "avoid_face_overlap"],
            "properties": {
              "target_anchor": {
                "type": "string",
                "enum": ["lower_third", "upper_third", "center", "center_left", "center_right", "custom"]
              },
              "safe_margin_ratio": { "type": "number", "minimum": 0.0, "maximum": 0.5 },
              "avoid_face_overlap": { "type": "boolean" },
              "placement_rect": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "integer", "minimum": 0 },
                  "y": { "type": "integer", "minimum": 0 },
                  "width": { "type": "integer", "minimum": 1 },
                  "height": { "type": "integer", "minimum": 1 }
                }
              }
            }
          },
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["animation_type"],
            "properties": {
              "animation_type": {
                "type": "string",
                "enum": ["fade_in_out", "pop_in", "slide_up", "none"]
              },
              "duration_ticks": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "audio_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialogue_ducking_enabled"],
      "properties": {
        "dialogue_ducking_enabled": { "type": "boolean" },
        "ducking_depth_db": { "type": "number" },
        "soundtrack_selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset_id": { "type": "string" },
            "style": { "type": "string" },
            "bpm_target": { "type": "number" },
            "ducking_attack_ticks": { "type": "integer", "minimum": 0 },
            "ducking_release_ticks": { "type": "integer", "minimum": 0 }
          }
        },
        "sfx_cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cue_id", "trigger_tick", "sfx_type"],
            "properties": {
              "cue_id": { "type": "string" },
              "trigger_tick": { "type": "integer", "minimum": 0 },
              "asset_id": { "type": "string" },
              "sfx_type": { "type": "string" }
            }
          }
        }
      }
    },
    "unsupported_features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_name", "reason", "fallback_policy", "accepted_by_user"],
        "properties": {
          "feature_name": { "type": "string" },
          "reason": { "type": "string" },
          "fallback_policy": {
            "type": "string",
            "enum": ["refuse", "omit", "safe_degrade"]
          },
          "permitted_fallback": { "type": "string" },
          "accepted_by_user": { "type": "boolean" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "input_brief_hash",
        "context_snapshot_hash",
        "accepted_at",
        "plan_hash"
      ],
      "properties": {
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "model", "generation_timestamp"],
          "properties": {
            "provider": { "type": "string" },
            "model": { "type": "string" },
            "temperature": { "type": "number" },
            "prompt_tokens": { "type": "integer" },
            "completion_tokens": { "type": "integer" },
            "generation_timestamp": { "type": "string" }
          }
        },
        "input_brief_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "context_snapshot_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "accepted_at": { "type": "string" },
        "plan_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
