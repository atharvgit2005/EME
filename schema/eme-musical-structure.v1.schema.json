{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eme.local/schemas/eme-musical-structure.v1.schema.json",
  "title": "EditingMechanicsEngineMusicalStructure",
  "description": "Deterministic Musical Structure Intelligence sidecar contract for EME Phase A2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "structureId",
    "source",
    "config",
    "meter",
    "bars",
    "phrases",
    "sections",
    "ambiguity"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "eme-musical-structure.v1"
    },
    "structureId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Content-addressed SHA-256 fingerprint of the musical structure analysis"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "sampleRate",
        "channels",
        "durationSamples",
        "durationTicks"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "durationSamples": {
          "type": "integer",
          "minimum": 0
        },
        "durationTicks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmVersion",
        "ticksPerSecond",
        "endpointConvention"
      ],
      "properties": {
        "algorithmVersion": { "type": "string" },
        "ticksPerSecond": { "type": "integer", "const": 120000 },
        "endpointConvention": { "type": "string", "const": "half-open" },
        "fftSize": { "type": "integer" },
        "hopLength": { "type": "integer" }
      }
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "confidence",
        "isAmbiguous"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["4/4", "3/4", "unsupported", "unknown"]
        },
        "numerator": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 16
        },
        "denominator": {
          "type": ["integer", "null"],
          "enum": [4, 8, null]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "isAmbiguous": { "type": "boolean" },
        "phaseOffsetBeats": { "type": "integer", "minimum": 0 },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "bars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "barIndex",
          "startTicks",
          "endTicks",
          "downbeatTicks",
          "beatsCount",
          "confidence"
        ],
        "properties": {
          "barIndex": { "type": "integer", "minimum": 0 },
          "startTicks": { "type": "integer", "minimum": 0 },
          "endTicks": { "type": "integer", "minimum": 0 },
          "downbeatTicks": { "type": "integer", "minimum": 0 },
          "beatsCount": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "phrases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phraseIndex",
          "startTicks",
          "endTicks",
          "barsCount",
          "confidence"
        ],
        "properties": {
          "phraseIndex": { "type": "integer", "minimum": 0 },
          "startTicks": { "type": "integer", "minimum": 0 },
          "endTicks": { "type": "integer", "minimum": 0 },
          "barsCount": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "cadenceStrength": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sectionIndex",
          "type",
          "startTicks",
          "endTicks",
          "confidence"
        ],
        "properties": {
          "id": { "type": "string" },
          "sectionIndex": { "type": "integer", "minimum": 0 },
          "type": {
            "type": "string",
            "enum": ["intro", "verse", "chorus", "build", "drop", "breakdown", "outro", "unknown"]
          },
          "startTicks": { "type": "integer", "minimum": 0 },
          "endTicks": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "uncertaintyState": {
            "type": "string",
            "enum": ["clear", "ambiguous", "insufficient_evidence", "transition_zone"]
          }
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hasHighAmbiguity",
        "isSparse",
        "isRubato",
        "notes"
      ],
      "properties": {
        "hasHighAmbiguity": { "type": "boolean" },
        "isSparse": { "type": "boolean" },
        "isRubato": { "type": "boolean" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
