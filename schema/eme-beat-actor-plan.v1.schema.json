{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eme.local/schemas/eme-beat-actor-plan.v1.schema.json",
  "title": "EditingMechanicsEngineBeatActorPlan",
  "description": "Deterministic Beat Actor editorial plan compiled from beat analysis and project state for atomic execution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "analysisRef",
    "policy",
    "cues",
    "diagnostics",
    "compiledOperations",
    "dryRun"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "eme-beat-actor-plan.v1"
    },
    "planId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Content-addressed SHA-256 fingerprint of the actor plan"
    },
    "analysisRef": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "atTicks", "targetTrackId", "confidence", "priority"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["jump_cut", "punch_zoom", "accent_flash", "kinetic_entrance", "sfx_cue"]
          },
          "atTicks": { "type": "integer", "minimum": 0 },
          "targetTrackId": { "type": "string" },
          "targetClipId": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
          "params": { "type": "object" },
          "sourceEventId": { "type": ["string", "null"] }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "rejectedCueId"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "rejectedCueId": { "type": "string" },
          "atTicks": { "type": "integer" }
        }
      }
    },
    "compiledOperations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" }
        }
      }
    },
    "dryRun": {
      "type": "boolean"
    }
  }
}
