{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eme.local/schemas/eme-beat-analysis.v1.schema.json",
  "title": "EditingMechanicsEngineBeatAnalysis",
  "description": "Deterministic Beat Analysis sidecar contract for EME Phase A1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "source",
    "config",
    "tempo",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "eme-beat-analysis.v1"
    },
    "analysisId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Content-addressed SHA-256 fingerprint of the analysis output"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "sampleRate",
        "channels",
        "durationSamples",
        "durationTicks"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "durationSamples": {
          "type": "integer",
          "minimum": 0
        },
        "durationTicks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmVersion",
        "sampleRate",
        "fftSize",
        "hopLength",
        "window",
        "frameCenterConvention"
      ],
      "properties": {
        "algorithmVersion": { "type": "string" },
        "sampleRate": { "type": "integer" },
        "fftSize": { "type": "integer" },
        "hopLength": { "type": "integer" },
        "window": { "type": "string", "enum": ["hann"] },
        "frameCenterConvention": { "type": "string" }
      }
    },
    "tempo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bpm",
        "confidence",
        "alternativesBpm",
        "isAmbiguous",
        "phaseOffsetSamples",
        "phaseOffsetTicks"
      ],
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 0,
          "maximum": 300
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "alternativesBpm": {
          "type": "array",
          "items": { "type": "number" }
        },
        "isAmbiguous": { "type": "boolean" },
        "phaseOffsetSamples": { "type": "integer" },
        "phaseOffsetTicks": { "type": "integer" }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beats",
        "downbeats",
        "onsets"
      ],
      "properties": {
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sampleIndex", "ticks", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "sampleIndex": { "type": "integer", "minimum": 0 },
              "ticks": { "type": "integer", "minimum": 0 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "strength": { "type": "number" }
            }
          }
        },
        "downbeats": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "barIndex", "ticks", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "barIndex": { "type": "integer" },
              "ticks": { "type": "integer", "minimum": 0 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "onsets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sampleIndex", "ticks", "strength", "band"],
            "properties": {
              "id": { "type": "string" },
              "sampleIndex": { "type": "integer", "minimum": 0 },
              "ticks": { "type": "integer", "minimum": 0 },
              "strength": { "type": "number" },
              "band": {
                "type": "string",
                "enum": ["low", "mid", "high", "broadband"]
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "startTicks", "endTicks", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["intro", "build", "drop", "breakdown", "outro"] },
              "startTicks": { "type": "integer", "minimum": 0 },
              "endTicks": { "type": "integer", "minimum": 0 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "meter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "confidence"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 1, "maximum": 16 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 16 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

