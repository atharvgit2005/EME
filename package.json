{
  "name": "editing-mechanics-engine",
  "version": "0.3.0",
  "description": "Local video editing studio with IDE-agent proposals, deterministic rendering, and verified delivery over stdio MCP",
  "main": "src/creative/index.js",
  "bin": {
    "eme": "bin/eme.js",
    "eme-mcp": "bin/eme-mcp.js",
    "eme-confirm": "bin/eme-confirm.js",
    "eme-studio": "bin/eme-studio.js",
    "eme-studio-mcp": "bin/eme-studio-mcp.js",
    "eme-tigergraph": "bin/eme-tigergraph.js",
    "eme-scene": "bin/eme-scene.js"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/studio/",
    "config/tigergraph.env.example",
    "scripts/studio-agent-call.cjs",
    "requirements/scene-m3.txt",
    "scripts/render-scene-preview.py",
    "experiments/visual-temporal-state/src/tracker/proposals.py",
    "experiments/visual-temporal-state/src/tracker/kalman.py",
    "experiments/visual-temporal-state/src/tracker/camera.py",
    "experiments/visual-temporal-state/src/propagation/flow_warper.py"
  ],
  "engines": {
    "node": ">=20.20.1"
  },
  "scripts": {
    "test": "npm run test:remediation && npm run test:studio && npm run test:scene && npm run test:placement && npm run test:editor && npm run test:design && npm run test:tigergraph",
    "doctor": "node bin/eme.js doctor",
    "capabilities": "node bin/eme.js capabilities",
    "validate:schema": "node tools/validate-schema.js",
    "package": "node scripts/package-release.js",
    "release": "node scripts/release.js",
    "serve": "node bin/eme.js editor",
    "test:approval": "node scripts/verify-approval-phase1.cjs",
    "test:native": "node scripts/verify-native-delivery.cjs",
    "test:contracts": "node scripts/verify-contract-baseline.cjs",
    "test:remediation": "node scripts/verify-remediation.cjs",
    "test:portable": "node scripts/verify-portable-inputs.cjs",
    "start": "node bin/eme-studio.js",
    "studio": "node bin/eme-studio.js",
    "test:studio": "node --test tests/studio.test.js",
    "test:legacy": "node --test tests/*.test.js tests/**/*.test.js",
    "test:scene": "node --test tests/scene.test.js",
    "test:placement": "node --test tests/title-placement.test.js",
    "test:editor": "node --test tests/direct-edits.test.js tests/waveform.test.js tests/studio-editor.test.js",
    "test:design": "node --test tests/design.test.js tests/design-ranking.test.js tests/design-revisions.test.js",
    "demo:design": "node scripts/demo-design-system.cjs",
    "demo:revisions": "node scripts/demo-design-revisions.cjs",
    "test:tigergraph": "node --test tests/tigergraph.test.js",
    "graph:schema": "node bin/eme-tigergraph.js schema",
    "graph:status": "node bin/eme-tigergraph.js status",
    "graph:sync": "node bin/eme-tigergraph.js sync",
    "graph:recall": "node bin/eme-tigergraph.js recall",
    "graph:verify": "node bin/eme-tigergraph.js verify",
    "verify:scene:m3": "node scripts/verify-scene-m3.cjs"
  },
  "keywords": [
    "video-editing",
    "motion-graphics",
    "rea",
    "antigravity",
    "ai-agent",
    "mcp-server"
  ],
  "author": "Atharv Paharia",
  "license": "MIT"
}
